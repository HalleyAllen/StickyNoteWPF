<Window x:Class="StickyNoteWPF.TaskListSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="任务清单设置" Height="430" Width="360"
        WindowStartupLocation="Manual"
        Icon="Resources/StickyNote.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinHeight="380" MinWidth="320"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="6" CaptionHeight="40"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="#FFF3F3F3" BorderBrush="#FF2D2D30" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="40"
                  Background="#FF2D2D30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚙ 任务清单设置" Foreground="White"
                           FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button x:Name="CloseButton" Grid.Column="1" Content="✕"
                        Width="40" Height="40" Background="Transparent"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="15" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16" Orientation="Vertical">
                <TextBlock Text="清单标题（用于区分）" FontSize="14" Margin="0,0,0,8"/>
                <TextBox x:Name="TitleBox" Height="30" Padding="6,3"
                         FontSize="14" BorderThickness="1" BorderBrush="#FFAAAAAA"
                         TextChanged="TitleBox_TextChanged" Margin="0,0,0,18"/>

                <TextBlock Text="背景颜色" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel x:Name="BgColorPanel" Margin="0,0,0,8"/>

                <!-- 图片背景 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="背景图片" FontSize="14"
                               VerticalAlignment="Center"/>
                    <Button x:Name="PickImageButton" Grid.Column="1" Content="选择图片"
                            Height="28" Padding="10,0" Margin="0,0,8,0"
                            Background="#FF2D2D30" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="PickImageButton_Click"/>
                    <Button x:Name="ClearImageButton" Grid.Column="2" Content="清除"
                            Height="28" Padding="10,0"
                            Background="Transparent" Foreground="#C33" BorderBrush="#CCC"
                            BorderThickness="1" Cursor="Hand" Click="ClearImageButton_Click"/>
                </Grid>

                <TextBlock Text="文字颜色" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel x:Name="TextColorPanel" Margin="0,0,0,18"/>

                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock Text="字体大小" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FontSizeValue" DockPanel.Dock="Right"
                               Text="16" FontSize="13" Foreground="#666"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="48"
                        SmallChange="1" LargeChange="4" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,18"
                        ValueChanged="FontSizeSlider_ValueChanged"/>

                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock Text="窗口透明度" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"
                               Text="100%" FontSize="13" Foreground="#666"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1.0"
                        SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                        IsSnapToTickEnabled="True"
                        ValueChanged="OpacitySlider_ValueChanged"/>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
