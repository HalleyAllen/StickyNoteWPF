<Window x:Class="StickyNoteWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StickyNoteWPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="便利贴管理" Height="480" Width="600"
        MinHeight="320" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/StickyNote.png"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent">
    <Window.Resources>
        <local:TitleFallbackConverter x:Key="TitleFallback"/>
        <local:ContrastTextConverter x:Key="ContrastText"/>
        <local:TaskProgressConverter x:Key="TaskProgress"/>

        <!-- 细滚动条样式：宽 5px、圆形滑块，参考便利贴 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" Width="5" HorizontalAlignment="Stretch"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand" Focusable="False" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type ButtonBase}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Rectangle x:Name="Rect" Width="5" Fill="#BBBBBB" RadiusX="3" RadiusY="3"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Rect" Property="Fill" Value="#888888"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand" Focusable="False" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type ButtonBase}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 视图切换面板：卡片视图用 WrapPanel，列表视图用 StackPanel -->
        <ItemsPanelTemplate x:Key="CardViewPanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="RowViewPanel">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>

        <!-- ===== 便签：卡片视图 ===== -->
        <DataTemplate x:Key="NoteCardTemplate">
            <Border Margin="6" Padding="10" CornerRadius="6" Width="180"
                    Background="{Binding Color}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBox Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                                 FontWeight="Bold" FontSize="13"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                 ToolTip="点击修改便签标题"
                                 TextChanged="TitleTextBox_TextChanged"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat='创建于 {0:g}'}"
                                   FontSize="10"
                                   Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🗑"
                            Width="28" Height="28" Margin="8,0,0,0"
                            Background="Transparent" Foreground="#C0392B"
                            BorderThickness="0" Cursor="Hand" FontSize="14"
                            ToolTip="删除便签"
                            Click="DeleteNoteButton_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== 便签：列表视图 ===== -->
        <DataTemplate x:Key="NoteRowTemplate">
            <Border Margin="6,3" Padding="12,8" CornerRadius="6"
                    HorizontalAlignment="Stretch" Background="{Binding Color}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding CreatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                       FontSize="10"
                                       Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                       Opacity="0.7"/>
                            <TextBox Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                                     FontWeight="Bold" FontSize="13"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                     ToolTip="点击修改便签标题"
                                     TextChanged="TitleTextBox_TextChanged"/>
                        </DockPanel>
                        <TextBlock Margin="0,3,8,0" Text="{Binding Text}"
                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                   Opacity="0.75"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🗑"
                            Width="28" Height="28" Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="Transparent" Foreground="#C0392B"
                            BorderThickness="0" Cursor="Hand" FontSize="14"
                            ToolTip="删除便签"
                            Click="DeleteNoteButton_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== 任务清单：卡片视图 ===== -->
        <DataTemplate x:Key="TaskCardTemplate">
            <Border Margin="6" Padding="10" CornerRadius="6" Width="180"
                    Background="{Binding Color}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBox Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                                 FontWeight="Bold" FontSize="13"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                 ToolTip="点击修改清单标题"
                                 TextChanged="TaskTitleTextBox_TextChanged"/>
                        <TextBlock FontSize="10"
                                   Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                   Margin="0,4,0,0"
                                   Text="{Binding Items, Converter={StaticResource TaskProgress}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🗑"
                            Width="28" Height="28" Margin="8,0,0,0"
                            Background="Transparent" Foreground="#C0392B"
                            BorderThickness="0" Cursor="Hand" FontSize="14"
                            ToolTip="删除清单"
                            Click="DeleteTaskListButton_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== 任务清单：列表视图 ===== -->
        <DataTemplate x:Key="TaskRowTemplate">
            <Border Margin="6,3" Padding="12,8" CornerRadius="6"
                    HorizontalAlignment="Stretch" Background="{Binding Color}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Items, Converter={StaticResource TaskProgress}}"
                                   FontSize="11"
                                   Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                   Opacity="0.75"/>
                        <TextBox Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                                 FontWeight="Bold" FontSize="13"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                 ToolTip="点击修改清单标题"
                                 TextChanged="TaskTitleTextBox_TextChanged"/>
                    </DockPanel>
                    <Button Grid.Column="1" Content="🗑"
                            Width="28" Height="28" Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="Transparent" Foreground="#C0392B"
                            BorderThickness="0" Cursor="Hand" FontSize="14"
                            ToolTip="删除清单"
                            Click="DeleteTaskListButton_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            CaptionHeight="32"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="#FFF3F3F3" BorderBrush="#FF2D2D30" BorderThickness="1">
        <Grid>
            <DockPanel LastChildFill="True">
            <!-- 自定义标题栏（含功能按钮） -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="32"
                  Background="#FF2D2D30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Image Source="pack://application:,,,/Resources/StickyNote.png" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="我的便利贴" Foreground="White"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 全部显示：停用/启用所有便签的隐藏与透明效果 -->
                <Button x:Name="ForceShowButton" Grid.Column="1" Content="👁"
                        Width="34" Height="32" Margin="0,0,2,0"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="15"
                        ToolTip="全部显示：关闭（点此开启，强制所有便签不透明且始终显示）"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 设置（全局） -->
                <Button x:Name="SettingsButton" Grid.Column="2" Content="⚙"
                        Width="34" Height="32" Margin="0,0,2,0"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="15"
                        ToolTip="设置：开机自启、窗口置顶、全局快捷键"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 最小化 -->
                <Button x:Name="MinButton" Grid.Column="3" Content="—"
                        Width="34" Height="32" Background="Transparent"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="14" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 关闭 -->
                <Button x:Name="CloseButton" Grid.Column="4" Content="✕"
                        Width="40" Height="32" Background="Transparent"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="14" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- 主体：左侧导航 + 右侧内容 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航栏 -->
                <Border Grid.Column="0" Background="#FF2D2D30">
                    <StackPanel Margin="0,6,0,0">
                        <Grid Height="44">
                            <Rectangle x:Name="NavIndicatorNotes" Width="3" HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch" Fill="#FF007ACC" Opacity="1"/>
                            <Button x:Name="NavNotes" Content="📝  便利贴" Click="NavNotes_Click"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="White" FontSize="13" FontWeight="SemiBold"
                                    HorizontalContentAlignment="Left" Padding="18,0,0,0"/>
                        </Grid>
                        <Grid Height="44">
                            <Rectangle x:Name="NavIndicatorTasks" Width="3" HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch" Fill="#FF007ACC" Opacity="0"/>
                            <Button x:Name="NavTasks" Content="✅  任务清单" Click="NavTasks_Click"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="#FF9AA0A6" FontSize="13" FontWeight="Normal"
                                    HorizontalContentAlignment="Left" Padding="18,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 右侧内容区 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部工具栏：搜索 / 排序 / 视图切换 / 新建 -->
                    <Border Grid.Row="0" Height="40" Background="#FFECECEC"
                            BorderBrush="#FFDCDCDC" BorderThickness="0,0,0,1">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 搜索框 -->
                            <Border Grid.Column="0" Height="26" VerticalAlignment="Center"
                                    CornerRadius="13" Background="White"
                                    BorderBrush="#FFD5D5D5" BorderThickness="1">
                                <DockPanel Margin="10,0,6,0" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,1,5,0"/>
                                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center" FontSize="12"
                                             TextChanged="SearchBox_TextChanged"
                                             ToolTip="按标题或内容关键字搜索"/>
                                </DockPanel>
                            </Border>

                            <!-- 排序 -->
                            <Button x:Name="SortButton" Grid.Column="1" Content="排序 ▾"
                                    Height="26" Margin="6,0,0,0" Padding="8,0"
                                    Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1"
                                    FontSize="12" Cursor="Hand"
                                    ToolTip="排序方式" Click="SortButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="默认排序" Tag="none" IsCheckable="True" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="按标题 A→Z" Tag="titleAsc" IsCheckable="True" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="按标题 Z→A" Tag="titleDesc" IsCheckable="True" Click="SortMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!-- 视图切换 -->
                            <Button x:Name="CardViewButton" Grid.Column="2" Content="卡片"
                                    Height="26" Margin="6,0,0,0" Padding="10,0"
                                    Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1"
                                    FontSize="12" Cursor="Hand"
                                    ToolTip="卡片视图" Click="CardViewButton_Click"/>
                            <Button x:Name="RowViewButton" Grid.Column="3" Content="列表"
                                    Height="26" Margin="4,0,0,0" Padding="10,0"
                                    Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1"
                                    FontSize="12" Cursor="Hand"
                                    ToolTip="列表视图" Click="RowViewButton_Click"/>

                            <!-- 默认外观（新建默认样式） -->
                            <Button x:Name="DefaultAppearanceButton" Grid.Column="4" Content="🎨 默认"
                                    Height="26" Margin="6,0,0,0" Padding="8,0"
                                    Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1"
                                    FontSize="12" Cursor="Hand"
                                    ToolTip="默认外观：设置新建便签与任务清单的默认样式（不影响已创建的）"/>

                            <!-- 新建 -->
                            <Button x:Name="AddNoteButton" Grid.Column="5" Content="＋ 新建"
                                    Height="26" Margin="6,0,0,0" Padding="12,0"
                                    Background="#FF007ACC" Foreground="White" BorderThickness="0"
                                    FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                    ToolTip="新建便利贴"/>
                        </Grid>
                    </Border>

                    <!-- 内容列表 -->
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyHint" Margin="24,0" VerticalAlignment="Center"
                                   Text="还没有便利贴，点击右上角「＋ 新建」创建第一张吧。"
                                   Foreground="#FF888888" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>

                        <!-- 便利贴列表（卡片/列表视图由代码切换模板） -->
                        <ListBox x:Name="NoteList" BorderThickness="0" Margin="8"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource NoteCardTemplate}"
                                 ItemsPanel="{StaticResource CardViewPanel}">
                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollViewer}">
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- 任务清单列表 -->
                        <ListBox x:Name="TaskListBox" BorderThickness="0" Margin="8"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="Collapsed"
                                 ItemTemplate="{StaticResource TaskCardTemplate}"
                                 ItemsPanel="{StaticResource CardViewPanel}">
                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollViewer}">
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
            </DockPanel>

        </Grid>
    </Border>
</Window>
