<Window x:Class="StickyNoteWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StickyNoteWPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="便利贴管理" Height="480" Width="440"
        MinHeight="240" MinWidth="320"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/StickyNote.png"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent">
    <Window.Resources>
        <local:TitleFallbackConverter x:Key="TitleFallback"/>
        <local:ContrastTextConverter x:Key="ContrastText"/>
        <local:TaskProgressConverter x:Key="TaskProgress"/>

        <!-- 细滚动条样式：宽 5px、圆形滑块，参考便利贴 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" Width="5" HorizontalAlignment="Stretch"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand" Focusable="False" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type ButtonBase}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Rectangle x:Name="Rect" Width="5" Fill="#BBBBBB" RadiusX="3" RadiusY="3"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Rect" Property="Fill" Value="#888888"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand" Focusable="False" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type ButtonBase}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            CaptionHeight="32"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="#FFF3F3F3" BorderBrush="#FF2D2D30" BorderThickness="1">
        <Grid>
            <DockPanel LastChildFill="True">
            <!-- 自定义标题栏（含功能按钮） -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="32"
                  Background="#FF2D2D30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Image Source="pack://application:,,,/Resources/StickyNote.png" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="我的便利贴" Foreground="White"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 全部显示：停用/启用所有便签的隐藏与透明效果 -->
                <Button x:Name="ForceShowButton" Grid.Column="1" Content="👁"
                        Width="34" Height="32" Margin="0,0,2,0"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="15"
                        ToolTip="全部显示：关闭（点此开启，强制所有便签不透明且始终显示）"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 设置 -->
                <Button x:Name="SettingsButton" Grid.Column="2" Content="⚙"
                        Width="34" Height="32" Margin="0,0,2,0"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="15"
                        ToolTip="设置" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 最小化 -->
                <Button x:Name="MinButton" Grid.Column="3" Content="—"
                        Width="34" Height="32" Background="Transparent"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="14" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 关闭 -->
                <Button x:Name="CloseButton" Grid.Column="4" Content="✕"
                        Width="40" Height="32" Background="Transparent"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="14" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- 主体：左侧导航 + 右侧内容 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航栏 -->
                <Border Grid.Column="0" Background="#FF2D2D30">
                    <StackPanel Margin="0,6,0,0">
                        <Grid Height="44">
                            <Rectangle x:Name="NavIndicatorNotes" Width="3" HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch" Fill="#FF007ACC" Opacity="1"/>
                            <Button x:Name="NavNotes" Content="📝  便利贴" Click="NavNotes_Click"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="White" FontSize="13" FontWeight="SemiBold"
                                    HorizontalContentAlignment="Left" Padding="18,0,0,0"/>
                        </Grid>
                        <Grid Height="44">
                            <Rectangle x:Name="NavIndicatorTasks" Width="3" HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch" Fill="#FF007ACC" Opacity="0"/>
                            <Button x:Name="NavTasks" Content="✅  任务清单" Click="NavTasks_Click"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="#FF9AA0A6" FontSize="13" FontWeight="Normal"
                                    HorizontalContentAlignment="Left" Padding="18,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 右侧内容区 -->
                <Grid Grid.Column="1">
                    <TextBlock x:Name="EmptyHint" Margin="20,26,20,0" VerticalAlignment="Top"
                               Text="还没有便利贴，点击右下角「＋」新建一个吧。"
                               Foreground="#888" TextWrapping="Wrap" HorizontalAlignment="Center"/>

            <!-- 便利贴列表 -->
            <ListBox x:Name="NoteList" BorderThickness="0" Margin="8,8,0,8"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Resources>
                    <Style TargetType="{x:Type ScrollViewer}">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6" Padding="10" CornerRadius="6" Width="180"
                                Background="{Binding Color}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                                             FontWeight="Bold" FontSize="13"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                             ToolTip="点击修改便签标题"
                                             TextChanged="TitleTextBox_TextChanged"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='创建于 {0:g}'}"
                                               FontSize="10"
                                               Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🗑"
                                        Width="28" Height="28" Margin="8,0,0,0"
                                        Background="Transparent" Foreground="#C0392B"
                                        BorderThickness="0" Cursor="Hand" FontSize="14"
                                        ToolTip="删除便签"
                                        Click="DeleteNoteButton_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 任务清单列表 -->
            <ListBox x:Name="TaskListBox" BorderThickness="0" Margin="8,8,0,8"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="Collapsed">
                <ListBox.Resources>
                    <Style TargetType="{x:Type ScrollViewer}">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6" Padding="10" CornerRadius="6" Width="180"
                                Background="{Binding Color}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                                             FontWeight="Bold" FontSize="13"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                             ToolTip="点击修改清单标题"
                                             TextChanged="TaskTitleTextBox_TextChanged"/>
                                    <TextBlock FontSize="10"
                                               Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                               Margin="0,4,0,0"
                                               Text="{Binding Items, Converter={StaticResource TaskProgress}}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🗑"
                                        Width="28" Height="28" Margin="8,0,0,0"
                                        Background="Transparent" Foreground="#C0392B"
                                        BorderThickness="0" Cursor="Hand" FontSize="14"
                                        ToolTip="删除清单"
                                        Click="DeleteTaskListButton_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                </Grid>
            </Grid>
            </DockPanel>

            <!-- 悬浮“新建”按钮：右下角圆形 + 加号，不受列表内容影响位置 -->
            <Button x:Name="AddNoteButton" Width="46" Height="46"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,26,16"
                    Background="#FF007ACC" BorderThickness="0"
                    Cursor="Hand" ToolTip="新建便利贴"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Rectangle Width="20" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="White"/>
                    <Rectangle Width="3" Height="20" RadiusX="1.5" RadiusY="1.5" Fill="White"/>
                </Grid>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#FF1E8FE0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
