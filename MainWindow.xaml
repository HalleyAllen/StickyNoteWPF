<Window x:Class="StickyNoteWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StickyNoteWPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="便利贴管理" Height="480" Width="360"
        MinHeight="240" MinWidth="280"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/StickyNote.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent">
    <Window.Resources>
        <local:TitleFallbackConverter x:Key="TitleFallback"/>
        <local:ContrastTextConverter x:Key="ContrastText"/>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            CaptionHeight="32"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="#FFF3F3F3" BorderBrush="#FF2D2D30" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <!-- 自定义标题栏（含新建按钮） -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="32"
                  Background="#FF2D2D30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Image Source="Resources/StickyNote.ico" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="我的便利贴" Foreground="White"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 新建按钮（放在标题栏） -->
                <Button x:Name="NewNoteButton" Grid.Column="1" Content="＋ 新建"
                        Margin="0,0,2,0" Padding="10,4"
                        Background="#FF007ACC" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="13"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 设置 -->
                <Button x:Name="SettingsButton" Grid.Column="3" Content="⚙"
                        Width="34" Height="32" Margin="0,0,2,0"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="15"
                        ToolTip="设置" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 最小化 -->
                <Button x:Name="MinButton" Grid.Column="4" Content="—"
                        Width="34" Height="32" Background="Transparent"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="14" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 关闭 -->
                <Button x:Name="CloseButton" Grid.Column="5" Content="✕"
                        Width="40" Height="32" Background="Transparent"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="14" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- 内容区 -->
            <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Margin="20,30,20,0"
                       Text="还没有便利贴，点击标题栏上的「＋ 新建」开始吧。"
                       Foreground="#888" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            <ListBox x:Name="NoteList" BorderThickness="0" Margin="8"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6" Padding="10" CornerRadius="6" Width="180"
                                Background="{Binding Color}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                                             FontWeight="Bold" FontSize="13"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                             ToolTip="点击修改便签标题"
                                             TextChanged="TitleTextBox_TextChanged"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                               MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='创建于 {0:g}'}"
                                               FontSize="10"
                                               Foreground="{Binding Color, Converter={StaticResource ContrastText}}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🗑"
                                        Width="28" Height="28" Margin="8,0,0,0"
                                        Background="Transparent" Foreground="#C0392B"
                                        BorderThickness="0" Cursor="Hand" FontSize="14"
                                        ToolTip="删除便签"
                                        Click="DeleteNoteButton_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
