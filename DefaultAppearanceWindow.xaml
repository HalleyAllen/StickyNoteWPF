<Window x:Class="StickyNoteWPF.DefaultAppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="默认外观" Height="560" Width="380"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/StickyNote.png"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinHeight="470" MinWidth="340"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="6" CaptionHeight="40"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="#FFF3F3F3" BorderBrush="#FF2D2D30" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="40"
                  Background="#FF2D2D30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🎨 默认外观" Foreground="White"
                           FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button x:Name="CloseButton" Grid.Column="1" Content="✕"
                        Width="40" Height="40" Background="Transparent"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="14" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16" Orientation="Vertical">
                <!-- 说明：仅作用于新建项（随所选类型变化） -->
                <TextBlock x:Name="HeaderText"
                           Text="以下设置仅作为新建便利贴的默认外观，不影响已创建的便利贴与任务清单。"
                           FontSize="11" Foreground="#FF999999" TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <!-- 默认作用对象：便利贴 / 任务清单（各自独立） -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="NoteRadio" GroupName="DefaultTarget" Content="📝 便利贴"
                                     FontSize="13" IsChecked="True" Cursor="Hand"
                                     Click="Target_Click"/>
                        <RadioButton x:Name="TaskRadio" GroupName="DefaultTarget" Content="✅ 任务清单"
                                     FontSize="13" Margin="18,0,0,0" Cursor="Hand"
                                     ToolTip="单独设置新建任务清单的默认外观，不影响便利贴"
                                     Click="Target_Click"/>
                    </StackPanel>
                    <Button x:Name="FollowNoteButton" Grid.Column="1" Content="跟随便利贴默认"
                            Visibility="Collapsed" FontSize="11" Padding="8,3" Cursor="Hand"
                            Background="Transparent" BorderBrush="#FFCCCCCC" BorderThickness="1"
                            ToolTip="取消任务清单已单独设置的默认值，改为跟随便利贴默认"
                            Click="FollowNoteButton_Click"/>
                </Grid>

                <!-- 窗口透明度（仅背景透明，文字不透明） -->
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock Text="初始窗口透明度" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"
                               Text="100%" FontSize="13" Foreground="#666"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1.0"
                        SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                        IsSnapToTickEnabled="True" Margin="0,0,0,18"
                        ValueChanged="OpacitySlider_ValueChanged"/>

                <!-- 初始字体大小 -->
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock Text="初始字体大小" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FontSizeValue" DockPanel.Dock="Right"
                               Text="14" FontSize="13" Foreground="#666"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="48"
                        SmallChange="1" LargeChange="2" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,18"
                        ValueChanged="FontSizeSlider_ValueChanged"/>

                <!-- 默认背景颜色 -->
                <TextBlock Text="初始背景颜色" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel x:Name="ColorPanel" Margin="0,0,0,18"/>

                <!-- 文字与按钮颜色（统一控制便签文字/标题文字/按钮） -->
                <TextBlock Text="初始文字与按钮颜色" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel x:Name="TextColorPanel" Margin="0,0,0,18"/>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
