<Window x:Class="StickyNoteWPF.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据同步" Width="480" Height="720" MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#FFF3F3F3"
        Icon="pack://application:,,,/Resources/StickyNote.png">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="数据同步" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,18" TextWrapping="Wrap" Foreground="#666666"
                       Text="设备直连无需账号；服务器同步需要登录。两种方式都保留本地离线使用。账号属于所连接的服务器。"/>
            <Button Content="设备直接同步（无需账号）" Height="36" Click="OpenPeer_Click" Margin="0,0,0,16"/>
            <TextBlock Text="服务器同步" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <StackPanel x:Name="ConnectionPanel">
                <TextBlock Text="服务器地址"/>
                <TextBox x:Name="ServerBox" Height="30" Margin="0,5,0,12" VerticalContentAlignment="Center"/>
                <TextBlock Text="服务器连接密钥"/>
                <PasswordBox x:Name="KeyBox" Height="30" Margin="0,5,0,12" VerticalContentAlignment="Center"/>
                <TextBlock Text="用户名（3–40 位字母、数字、_ 或 -）"/>
                <TextBox x:Name="UsernameBox" Height="30" Margin="0,5,0,12" VerticalContentAlignment="Center"/>
                <TextBlock Text="密码（10–128 位；仅登录或注册时填写）"/>
                <PasswordBox x:Name="PasswordInput" Height="30" Margin="0,5,0,14" VerticalContentAlignment="Center"/>
                <WrapPanel>
                    <Button Content="登录" Width="88" Height="32" Click="Login_Click" Margin="0,0,10,0"/>
                    <Button Content="注册并登录" Width="110" Height="32" Click="Register_Click"/>
                </WrapPanel>
            </StackPanel>
            <Separator Margin="0,18,0,14"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#444444"/>
            <StackPanel x:Name="ActionPanel" Orientation="Horizontal" Margin="0,12,0,14">
                <Button x:Name="SyncButton" Content="立即同步" Width="108" Height="34" Click="Sync_Click" Margin="0,0,10,0"/>
                <Button x:Name="LogoutButton" Content="退出登录" Width="94" Height="34" Click="Logout_Click"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#777777" FontSize="12"
                       Text="同步便签、任务清单、子任务和各自样式。两端发生冲突时，由你选择保留本机或服务器版本；下载替换前会备份本机数据。窗口位置、全局设置及背景图片文件保留在本机。请连接你信任的服务器。"/>
        </StackPanel>
    </ScrollViewer>
</Window>
