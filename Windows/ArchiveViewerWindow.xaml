<Window x:Class="StickyNoteWPF.ArchiveViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:StickyNoteWPF.Models;assembly=StickyNote.Sync.Shared"
        Title="归档详情" Width="620" Height="560" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource UiCanvas}"
        Foreground="{DynamicResource UiText}" FontFamily="Segoe UI, Microsoft YaHei" FontSize="14"
        Icon="pack://application:,,,/StickyNote;component/Resources/StickyNote.png">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:TaskItem}" ItemsSource="{Binding SubItems}">
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Top" Margin="0,3,8,0"/>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="420">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                        </DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="Description" Foreground="{DynamicResource UiMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="RestoreButton" Content="恢复到日常列表" Style="{StaticResource UiPrimaryButton}" Margin="0,0,10,0"/>
            <Button Content="关闭" Click="Close_Click"/>
        </StackPanel>
        <Grid>
            <TextBox x:Name="NoteBody" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="{DynamicResource UiSurface}"
                     Foreground="{DynamicResource UiText}" BorderThickness="0" Padding="16"/>
            <TreeView x:Name="ArchivedTaskTree" Visibility="Collapsed" Background="{DynamicResource UiSurface}"
                      Foreground="{DynamicResource UiText}" BorderThickness="0" Padding="12"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style></TreeView.ItemContainerStyle>
            </TreeView>
        </Grid>
    </DockPanel>
    </Grid>
</Window>
