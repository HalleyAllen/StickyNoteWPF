<UserControl x:Class="StickyNoteWPF.DefaultAppearancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI, Microsoft YaHei" FontSize="14" Foreground="{DynamicResource UiText}" UseLayoutRounding="True">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Dialog.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16" Orientation="Vertical">
                <TextBlock x:Name="AppearanceTitle" Text="便签默认外观" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <!-- 说明：仅作用于新建项（作用类型由打开入口固定） -->
                <TextBlock x:Name="HeaderText"
                           Text="以下设置仅作为新建便利贴的默认外观，不影响任务清单与已创建的便利贴。"
                           FontSize="12" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <!-- 作用对象：便利贴 / 任务清单（由打开入口决定，只显示对应的一项） -->
                <Grid Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="NoteRadio" GroupName="DefaultTarget" Content="便利贴"
                                     FontSize="13" IsChecked="True" Cursor="Hand"/>
                        <RadioButton x:Name="TaskRadio" GroupName="DefaultTarget" Content="任务清单"
                                     FontSize="13" Margin="18,0,0,0" Cursor="Hand"
                                     ToolTip="设置新建任务清单的默认外观，不影响便利贴"/>
                    </StackPanel>
                </Grid>

                <!-- 窗口透明度（仅背景透明，文字不透明） -->
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock Text="初始窗口透明度" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"
                               Text="100%" FontSize="13" Foreground="{DynamicResource UiMuted}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1.0"
                        SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                        IsSnapToTickEnabled="True" Margin="0,0,0,18"
                        ValueChanged="OpacitySlider_ValueChanged"/>

                <!-- 初始字体大小 -->
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock Text="初始字体大小" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FontSizeValue" DockPanel.Dock="Right"
                               Text="14" FontSize="13" Foreground="{DynamicResource UiMuted}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="48"
                        SmallChange="1" LargeChange="2" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,18"
                        ValueChanged="FontSizeSlider_ValueChanged"/>

                <!-- 默认背景颜色 -->
                <TextBlock Text="初始背景颜色" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel x:Name="ColorPanel" Margin="0,0,0,18"/>

                <!-- 文字与按钮颜色（统一控制便签文字/标题文字/按钮） -->
                <TextBlock Text="初始文字与按钮颜色" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel x:Name="TextColorPanel" Margin="0,0,0,18"/>

                <!-- 任务清单默认专有：是否显示已完成任务（便利贴默认窗口不显示） -->
                <CheckBox x:Name="ShowCompletedCheck" Content="显示已完成任务"
                          FontSize="14" Cursor="Hand" VerticalAlignment="Center"
                          Visibility="Collapsed"
                          ToolTip="关闭后，新建的任务清单将隐藏已勾选完成的任务；创建后可在该清单的 ⚙ 设置中单独修改"
                          Checked="ShowCompletedCheck_Changed"
                          Unchecked="ShowCompletedCheck_Changed"/>
            </StackPanel>
            </ScrollViewer>
</UserControl>
