<UserControl x:Class="StickyNoteWPF.SyncPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI, Microsoft YaHei" FontSize="14" Foreground="{DynamicResource UiText}" UseLayoutRounding="True">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Dialog.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="服务器同步" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,18" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"
                       Text="连接自己或他人部署的服务器，登录后手动同步。账号属于所连接的服务器；不登录仍可离线使用。"/>
            <StackPanel x:Name="ConnectionPanel">
                <TextBlock Text="服务器地址"/>
                <TextBox x:Name="ServerBox" Height="34" Margin="0,5,0,12" VerticalContentAlignment="Center"/>
                <TextBlock Text="服务器连接密钥"/>
                <PasswordBox x:Name="KeyBox" Height="34" Margin="0,5,0,12" VerticalContentAlignment="Center"/>
                <TextBlock Text="用户名（3–40 位字母、数字、_ 或 -）"/>
                <TextBox x:Name="UsernameBox" Height="34" Margin="0,5,0,12" VerticalContentAlignment="Center"/>
                <TextBlock Text="密码（10–128 位；仅登录或注册时填写）"/>
                <PasswordBox x:Name="PasswordInput" Height="34" Margin="0,5,0,14" VerticalContentAlignment="Center"/>
                <WrapPanel>
                    <Button Content="登录" Width="88" Height="36" Click="Login_Click" Margin="0,0,10,0"/>
                    <Button Content="注册并登录" Width="110" Height="36" Click="Register_Click"/>
                </WrapPanel>
            </StackPanel>
            <Separator Margin="0,18,0,14"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource UiText}"/>
            <StackPanel x:Name="ActionPanel" Orientation="Horizontal" Margin="0,12,0,14">
                <Button x:Name="SyncButton" Content="立即同步" Width="108" Height="34" Click="Sync_Click" Margin="0,0,10,0"/>
                <Button x:Name="LogoutButton" Content="退出登录" Width="94" Height="34" Click="Logout_Click"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" FontSize="12"
                       Text="同步便签、任务清单、子任务和各自样式。两端发生冲突时，由你选择保留本机或服务器版本；下载替换前会备份本机数据。窗口位置、全局设置及背景图片文件保留在本机。请连接你信任的服务器。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
