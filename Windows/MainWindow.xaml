<Window
    x:Class="StickyNoteWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:StickyNoteWPF"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="便利贴管理"
    Width="860"
    Height="600"
    MinWidth="620"
    MinHeight="420"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    FontFamily="Segoe UI, Microsoft YaHei"
    FontSize="14"
    Foreground="{DynamicResource UiText}"
    UseLayoutRounding="True"
    Background="{DynamicResource UiCanvas}"
    Icon="pack://application:,,,/Resources/StickyNote.png">
    <Window.Resources>
        <local:CardBrushConverter x:Key="CardBrush"/>
        <local:NotePreviewConverter x:Key="NotePreview"/>
        <local:TitleFallbackConverter
            x:Key="TitleFallback" />
        <local:TaskProgressConverter
            x:Key="TaskProgress" />
        <ItemsPanelTemplate
            x:Key="CardViewPanel">
            <local:VirtualizingCardPanel ItemWidth="242" ItemHeight="188"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate
            x:Key="RowViewPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <Style
            x:Key="ItemTitle"
            TargetType="TextBox">
            <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}"/>
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="FontSize"
                Value="15" />
            <Setter
                Property="Foreground"
                Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=text}" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
        </Style>
        <Style
            x:Key="CardSurface"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="{Binding Color, Converter={StaticResource CardBrush}}" />
            <Setter
                Property="BorderBrush"
                Value="{DynamicResource UiLine}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="10" />
            <Setter
                Property="Margin"
                Value="6,6,16,16" />
        </Style>
        <!-- 阴影只渲染背景，不让整个卡片（尤其文字）被栅格化。 -->
        <Style x:Key="CardShadowLayer" TargetType="Border">
            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Value="True">
                    <Setter
                        Property="Effect"
                        Value="{DynamicResource UiCardShadow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="ManagerList"
            TargetType="ListBox">
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter
                Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled" />
            <Setter
                Property="ScrollViewer.VerticalScrollBarVisibility"
                Value="Auto" />
            <Setter
                Property="ItemContainerStyle">
                <Setter.Value>
                    <Style
                        TargetType="ListBoxItem">
                        <EventSetter Event="PreviewMouseDown" Handler="Card_PreviewMouseDown"/>
                        <EventSetter Event="GotKeyboardFocus" Handler="Card_GotKeyboardFocus"/>
                        <Setter
                            Property="Padding"
                            Value="0" />
                        <Setter
                            Property="Margin"
                            Value="0" />
                        <Setter
                            Property="HorizontalContentAlignment"
                            Value="Stretch" />
                        <Setter
                            Property="Template">
                            <Setter.Value>
                                <ControlTemplate
                                    TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Panel.ZIndex" Value="1"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate
            x:Key="NoteCardTemplate">
            <Border
                Style="{StaticResource CardSurface}"
                Width="220"
                Height="166">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="4" />
                        <RowDefinition
                            Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Style="{StaticResource CardShadowLayer}"/>
                    <Border
                        Background="{Binding Color}"
                        CornerRadius="9,9,0,0" />
                    <Grid
                        Grid.Row="1"
                        Margin="16,14,12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox
                            Style="{StaticResource ItemTitle}"
                            Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="点击修改标题；双击卡片打开便签"
                            TextChanged="TitleTextBox_TextChanged" />
                        <TextBlock
                            Grid.Row="1"
                            Text="{Binding Text, Converter={StaticResource NotePreview}}"
                            Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                            FontSize="13"
                            Margin="0,10,0,8"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                            MaxHeight="60" />
                        <DockPanel
                            Grid.Row="2">
                            <Button
                                DockPanel.Dock="Right"
                                Style="{StaticResource UiDeleteButton}" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                                Content=""
                                Width="28"
                                Height="28"
                                ToolTip="删除便签"
                                Click="DeleteNoteButton_Click" />
                            <TextBlock
                                Text="{Binding CreatedAt, StringFormat='创建于 {0:MM-dd HH:mm}'}"
                                Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="NoteRowTemplate">
            <Border
                Style="{StaticResource CardSurface}"
                Margin="6,6,12,12"
                MinHeight="78">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="4" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3" Style="{StaticResource CardShadowLayer}"/>
                    <Border
                        Background="{Binding Color}"
                        CornerRadius="9,0,0,9" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,12">
                        <TextBox
                            Style="{StaticResource ItemTitle}"
                            Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="点击修改标题"
                            TextChanged="TitleTextBox_TextChanged" />
                        <TextBlock
                            Text="{Binding Text, Converter={StaticResource NotePreview}}"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                            FontSize="13"
                            Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="8,0">
                        <TextBlock
                            Text="{Binding CreatedAt, StringFormat='{}{0:MM-dd}'}"
                            Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />
                        <Button
                            Style="{StaticResource UiDeleteButton}" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                            Content=""
                            ToolTip="删除便签"
                            Click="DeleteNoteButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="TaskCardTemplate">
            <Border
                Style="{StaticResource CardSurface}"
                Width="220"
                Height="166">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="4" />
                        <RowDefinition
                            Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Style="{StaticResource CardShadowLayer}"/>
                    <Border
                        Background="{Binding Color}"
                        CornerRadius="9,9,0,0" />
                    <Grid
                        Grid.Row="1"
                        Margin="16,14,12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox
                            Style="{StaticResource ItemTitle}"
                            Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="点击修改标题；双击卡片打开清单"
                            TextChanged="TaskTitleTextBox_TextChanged" />
                        <ItemsControl
                            Grid.Row="1"
                            Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                            ItemsSource="{Binding Items}"
                            Margin="0,10,0,8"
                            MaxHeight="56"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            ClipToBounds="True"
                            IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.Template><ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate></ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding Text, Converter={StaticResource NotePreview}}"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        FontSize="13"
                                        Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style
                                                TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsDone}"
                                                        Value="True">
                                                        <Setter
                                                            Property="TextDecorations"
                                                            Value="Strikethrough" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel
                            Grid.Row="2">
                            <Button
                                DockPanel.Dock="Right"
                                Style="{StaticResource UiDeleteButton}" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                                Content=""
                                Width="28"
                                Height="28"
                                ToolTip="删除清单"
                                Click="DeleteTaskListButton_Click" />
                            <TextBlock
                                Text="{Binding Items, Converter={StaticResource TaskProgress}}"
                                Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="TaskRowTemplate">
            <Border
                Style="{StaticResource CardSurface}"
                Margin="6,6,12,12"
                MinHeight="78">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="4" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3" Style="{StaticResource CardShadowLayer}"/>
                    <Border
                        Background="{Binding Color}"
                        CornerRadius="9,0,0,9" />
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource ItemTitle}"
                        Margin="14,12"
                        Text="{Binding Title, Converter={StaticResource TitleFallback}, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="点击修改标题"
                        TextChanged="TaskTitleTextBox_TextChanged" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="8,0">
                        <TextBlock
                            Text="{Binding Items, Converter={StaticResource TaskProgress}}"
                            Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                            FontSize="12"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                        <Button
                            Style="{StaticResource UiDeleteButton}" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource CardBrush}, ConverterParameter=secondary}"
                            Content=""
                            ToolTip="删除清单"
                            Click="DeleteTaskListButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border
        BorderBrush="{DynamicResource UiLine}"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="44" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="TitleBar"
                Background="{DynamicResource UiSurface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="44" />
                    <ColumnDefinition
                        Width="44" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Orientation="Horizontal"
                    Margin="18,0"
                    VerticalAlignment="Center">
                    <Image
                        Source="pack://application:,,,/Resources/StickyNote.png"
                        Width="20"
                        Height="20"
                        Margin="0,0,10,0" />
                    <TextBlock
                        Text="我的便利贴"
                        FontWeight="SemiBold" />
                </StackPanel>
                <Button
                    x:Name="MinButton"
                    Grid.Column="1"
                    Style="{StaticResource UiIconButton}"
                    Content=""
                    ToolTip="最小化"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button
                    x:Name="CloseButton"
                    Grid.Column="2"
                    Style="{StaticResource UiDeleteButton}"
                    Content=""
                    ToolTip="关闭管理窗口（继续在托盘运行）"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
            <Grid
                Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="148" />
                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Background="{DynamicResource UiSidebar}"
                    BorderBrush="{DynamicResource UiLine}"
                    BorderThickness="0,1,1,0">
                    <DockPanel
                        Margin="10,20,10,14">
                        <Button
                            x:Name="SettingsButton"
                            Style="{StaticResource UiNavigationButton}"
                            DockPanel.Dock="Bottom"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,10"
                            ToolTip="常规设置、设备与账号同步">
                            <StackPanel
                                Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="{StaticResource UiIconFont}"
                                    Text=""
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="设置" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <Grid
                                Margin="0,0,0,6">
                                <Border
                                    x:Name="NavIndicatorNotes"
                                    CornerRadius="7"
                                    Background="{DynamicResource UiSelected}" />
                                <Button
                                    x:Name="NavNotes"
                                    Style="{StaticResource UiNavigationButton}"
                                    Content="便利贴"
                                    HorizontalContentAlignment="Left"
                                    Padding="16,11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NavNotes_Click" />
                            </Grid>
                            <Grid>
                                <Border
                                    x:Name="NavIndicatorTasks"
                                    CornerRadius="7"
                                    Background="{DynamicResource UiSelected}"
                                    Opacity="0" />
                                <Button
                                    x:Name="NavTasks"
                                    Style="{StaticResource UiNavigationButton}"
                                    Content="任务清单"
                                    HorizontalContentAlignment="Left"
                                    Padding="16,11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NavTasks_Click" />
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid
                    Grid.Column="1"
                    Margin="24,24,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel
                        Margin="0,0,8,20">
                        <Button
                            x:Name="AddNoteButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource UiPrimaryButton}"
                            Content="＋ 新建"
                            Padding="16,8" />
                        <TextBlock
                            x:Name="PageTitle"
                            Text="便利贴"
                            FontSize="24"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid
                        Grid.Row="1"
                        Margin="0,0,8,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{DynamicResource UiSurface}"
                            BorderBrush="{DynamicResource UiLine}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Margin="0,0,8,0">
                            <DockPanel
                                Margin="10,0">
                                <TextBlock
                                    DockPanel.Dock="Left"
                                    Text=""
                                    FontFamily="{StaticResource UiIconFont}"
                                    Foreground="{DynamicResource UiMuted}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                                <TextBox
                                    x:Name="SearchBox"
                                    Foreground="{DynamicResource UiText}"
                                    CaretBrush="{DynamicResource UiText}"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    VerticalContentAlignment="Center"
                                    TextChanged="SearchBox_TextChanged"
                                    ToolTip="按标题或内容关键字搜索"
                                    AutomationProperties.Name="搜索标题或内容" />
                            </DockPanel>
                        </Border>
                        <Button
                            x:Name="SortButton"
                            Grid.Column="1"
                            Style="{StaticResource UiToolbarButton}"
                            Margin="0,0,8,0"
                            Click="SortButton_Click"
                            ToolTip="排序方式">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource UiSortMenu}" Placement="Bottom" VerticalOffset="6">
                                    <MenuItem
                                        Header="默认排序"
                                        Tag="none"
                                        IsCheckable="True"
                                        Click="SortMenuItem_Click" />
                                    <MenuItem
                                        Header="按标题 A→Z"
                                        Tag="titleAsc"
                                        IsCheckable="True"
                                        Click="SortMenuItem_Click" />
                                    <MenuItem
                                        Header="按标题 Z→A"
                                        Tag="titleDesc"
                                        IsCheckable="True"
                                        Click="SortMenuItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource UiSortGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button
                            x:Name="CardViewButton"
                            Grid.Column="2"
                            Style="{StaticResource UiToolbarButton}"
                            ToolTip="卡片视图"
                            Click="CardViewButton_Click"
                            Margin="0,0,4,0">
                            <Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource UiGridGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                        </Button>
                        <Button
                            x:Name="RowViewButton"
                            Grid.Column="3"
                            Style="{StaticResource UiToolbarButton}"
                            ToolTip="列表视图"
                            Click="RowViewButton_Click"
                            Margin="0,0,8,0">
                            <Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource UiListGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button
                            x:Name="DefaultAppearanceButton"
                            Grid.Column="4"
                            Style="{StaticResource UiToolbarButton}"
                            ToolTip="默认外观">
                            <Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource UiPaletteGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button
                            x:Name="ForceShowButton"
                            Grid.Column="5"
                            Style="{StaticResource UiToolbarButton}"
                            ToolTip="全部显示">
                            <Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource UiEyeGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                        </Button>
                    </Grid>
                    <Grid
                        Grid.Row="2">
                        <TextBlock
                            x:Name="EmptyHint"
                            Text="还没有便利贴，点击右上角「＋ 新建」创建第一张吧。"
                            Foreground="{DynamicResource UiMuted}"
                            FontSize="14"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24" />
                        <ListBox
                            x:Name="NoteList"
                            Style="{StaticResource ManagerList}"
                            ItemTemplate="{StaticResource NoteCardTemplate}"
                            ItemsPanel="{StaticResource CardViewPanel}" />
                        <ListBox
                            x:Name="TaskListBox"
                            Style="{StaticResource ManagerList}"
                            Visibility="Collapsed"
                            ItemTemplate="{StaticResource TaskCardTemplate}"
                            ItemsPanel="{StaticResource CardViewPanel}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
