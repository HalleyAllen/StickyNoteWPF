<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>StickyNote</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\StickyNote.ico</ApplicationIcon>
    <!-- 自包含发布时只保留简体中文语言包，去掉多余语言资源 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\StickyNote.Sync.Shared.csproj" />
    <Resource Include="Resources\StickyNote.png" />
    <!-- 图标同时嵌入程序集（供 pack://application 引用，单文件发布下可用）与复制到输出目录（供托盘文件加载） -->
    <Resource Include="Resources\StickyNote.ico" />
    <Content Include="Resources\StickyNote.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 发布后清理历史目录并复制图标资源。 -->
  <Target Name="CleanPublishLayout" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\publish-layout.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -PublishDir &quot;$(PublishDir.Replace('\','/'))&quot; -Rid &quot;$(RuntimeIdentifier)&quot;" />
  </Target>

  <!-- 普通生成（Build，无 RID）后清掉发布残留的运行时文件，让根目录保持像 Debug 一样干净 -->
  <Target Name="CleanBuildExtras" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <RemoveDir Directories="$(TargetDir)lib" Condition="Exists('$(TargetDir)lib')" />
    <RemoveDir Directories="$(TargetDir)zh-Hans" Condition="Exists('$(TargetDir)zh-Hans')" />
    <!-- 依赖程序集由 SDK 管理，不能再按文件名前缀删除。 -->
  </Target>

</Project>
