<Window x:Class="StickyNoteWPF.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="便利贴"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        MinWidth="160" MinHeight="120"
        SizeToContent="Manual"
        Icon="pack://application:,,,/Resources/StickyNote.png">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            CaptionHeight="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <!-- 根容器：透明，避免整体被当作半透明单元合成 -->
    <Grid>
        <!-- 底层：半透明背景 + 阴影（有图片时背景为 ImageBrush，否则为纯色） -->
        <Border x:Name="RootBorder" CornerRadius="10"
                BorderThickness="1" BorderBrush="#55000000"/>

        <!-- 上层：内容（文字完全不透明，独立渲染） -->
        <DockPanel LastChildFill="True" Margin="1">
            <!-- 标题栏 -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="28"
                  Background="#22000000" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" Text="便利贴" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="11" Foreground="#333"/>
                <Button x:Name="LockButton" Grid.Column="1" Content="🔓"
                        Width="26" Height="22" Margin="0,0,2,0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="未锁定（点此锁定，锁定后不可编辑）" Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="EyeButton" Grid.Column="2" Content="👁"
                        Width="26" Height="22" Margin="0,0,2,0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="鼠标移入才显示" Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="SettingsButton" Grid.Column="3" Content="⚙"
                        Width="26" Height="22" Margin="0,0,2,0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="便签设置" Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="CloseButton" Grid.Column="4" Content="✕"
                        Width="26" Height="22" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="关闭" Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
            <!-- 文本编辑区 -->
            <TextBox x:Name="NoteTextBox" DockPanel.Dock="Bottom"
                     BorderThickness="0" Background="Transparent"
                     Padding="8" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Foreground="#222"
                     CaretBrush="#222" UndoLimit="100"/>
        </DockPanel>
    </Grid>
</Window>
