<Window x:Class="StickyNoteWPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="设置" Height="470" Width="380"
        WindowStartupLocation="CenterOwner"
        Icon="Resources/StickyNote.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="0" CaptionHeight="40"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="#FFF3F3F3" BorderBrush="#FF2D2D30" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="40"
                  Background="#FF2D2D30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚙ 设置" Foreground="White"
                           FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button x:Name="CloseButton" Grid.Column="1" Content="✕"
                        Width="40" Height="40" Background="Transparent"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="15" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <StackPanel Margin="20,16" Orientation="Vertical">
                <!-- 开机自启 -->
                <DockPanel LastChildFill="True" Margin="0,0,0,18">
                    <TextBlock Text="开机自启" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox x:Name="StartupCheck" DockPanel.Dock="Right"
                              VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- 全局置顶 -->
                <DockPanel LastChildFill="True" Margin="0,0,0,18">
                    <TextBlock Text="便签始终置顶" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox x:Name="TopmostCheck" DockPanel.Dock="Right"
                              VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- 窗口透明度（仅背景透明，文字不透明） -->
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock Text="便签窗口透明度" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"
                               Text="100%" FontSize="13" Foreground="#666"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1.0"
                        SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                        IsSnapToTickEnabled="True" Margin="0,0,0,18"
                        ValueChanged="OpacitySlider_ValueChanged"/>

                <!-- 默认便签颜色 -->
                <TextBlock Text="新建便签默认颜色" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel x:Name="ColorPanel" Margin="0,0,0,18"/>

                <!-- 文字与按钮颜色（统一控制便签文字/标题文字/按钮） -->
                <TextBlock Text="文字与按钮颜色" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel x:Name="TextColorPanel" Margin="0,0,0,18"/>

                <TextBlock x:Name="Hint" Text="" FontSize="12" Foreground="#C0392B"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
