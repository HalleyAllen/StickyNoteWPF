<Window x:Class="StickyNoteWPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="设置" Height="560" Width="380"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/StickyNote.png"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinHeight="420" MinWidth="340"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="6" CaptionHeight="40"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="#FFF3F3F3" BorderBrush="#FF2D2D30" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="40"
                  Background="#FF2D2D30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚙ 设置" Foreground="White"
                           FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button x:Name="CloseButton" Grid.Column="1" Content="✕"
                        Width="40" Height="40" Background="Transparent"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="14" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16" Orientation="Vertical">
                <!-- 开机自启 -->
                <DockPanel LastChildFill="True" Margin="0,0,0,18">
                    <TextBlock Text="开机自启" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox x:Name="StartupCheck" DockPanel.Dock="Right"
                              VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- 全局置顶 -->
                <DockPanel LastChildFill="True" Margin="0,0,0,18">
                    <TextBlock Text="窗口始终置顶" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox x:Name="TopmostCheck" DockPanel.Dock="Right"
                              VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- 全局快捷键：隐藏/显示所有窗口（设置窗口除外） -->
                <TextBlock Text="隐藏/显示全部窗口快捷键" FontSize="14" Margin="0,0,0,6"/>
                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                    <TextBlock x:Name="HotKeyHint" Text="按下快捷键可一键隐藏或显示所有便签与任务清单（设置窗口除外）"
                               FontSize="11" Foreground="#FF999999" TextWrapping="Wrap"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border x:Name="HotKeyBox" BorderBrush="#FFCCCCCC" BorderThickness="1"
                            CornerRadius="3" Background="White" Height="30" MinWidth="150"
                            Padding="10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HotKeyText" Text="未设置" FontSize="13"
                                   VerticalAlignment="Center" Foreground="#FF555555"/>
                    </Border>
                    <Button x:Name="SetHotKeyButton" Content="修改" Width="56" Height="30"
                            Margin="8,0,0,0" Cursor="Hand" FontSize="13"/>
                    <Button x:Name="ClearHotKeyButton" Content="删除" Width="56" Height="30"
                            Margin="8,0,0,0" Cursor="Hand" FontSize="13"/>
                </StackPanel>

                <!-- 窗口透明度（仅背景透明，文字不透明） -->
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock Text="初始窗口透明度" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"
                               Text="100%" FontSize="13" Foreground="#666"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1.0"
                        SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                        IsSnapToTickEnabled="True" Margin="0,0,0,18"
                        ValueChanged="OpacitySlider_ValueChanged"/>

                <!-- 初始字体大小（仅影响新建便签） -->
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock Text="初始字体大小" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FontSizeValue" DockPanel.Dock="Right"
                               Text="14" FontSize="13" Foreground="#666"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="48"
                        SmallChange="1" LargeChange="2" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,18"
                        ValueChanged="FontSizeSlider_ValueChanged"/>

                <!-- 默认便签颜色 -->
                <TextBlock Text="初始背景颜色" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel x:Name="ColorPanel" Margin="0,0,0,18"/>

                <!-- 文字与按钮颜色（统一控制便签文字/标题文字/按钮） -->
                <TextBlock Text="初始文字与按钮颜色" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel x:Name="TextColorPanel" Margin="0,0,0,18"/>

                <TextBlock x:Name="Hint" Text="" FontSize="12" Foreground="#C0392B"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
