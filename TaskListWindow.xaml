<Window x:Class="StickyNoteWPF.TaskListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:StickyNoteWPF"
        xmlns:models="clr-namespace:StickyNoteWPF.Models"
        x:Name="Root"
        Title="任务清单" Height="360" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" Topmost="True"
        ShowInTaskbar="False" FontFamily="Microsoft YaHei">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                          CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="12" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（鼠标拖动移动窗口） -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="32"
                  Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Grid.Column="0" VerticalAlignment="Center"
                           Margin="10,0,4,0" FontWeight="SemiBold" FontSize="13"
                           TextTrimming="CharacterEllipsis" Text="任务清单"/>

                <!-- 锁定 -->
                <Button x:Name="LockButton" Grid.Column="1" Content="🔓"
                        Width="32" Height="32" Background="Transparent"
                        Foreground="#FF222222" BorderThickness="0" Cursor="Hand"
                        FontSize="14" ToolTip="未锁定（点此锁定，锁定后不可编辑）"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 悬停显示 -->
                <Button x:Name="EyeButton" Grid.Column="2" Content="🚫"
                        Width="32" Height="32" Background="Transparent"
                        Foreground="#FF222222" BorderThickness="0" Cursor="Hand"
                        FontSize="14" ToolTip="始终显示（点此开启悬停）"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 设置 -->
                <Button x:Name="SettingsButton" Grid.Column="3" Content="⚙"
                        Width="32" Height="32" Background="Transparent"
                        Foreground="#FF222222" BorderThickness="0" Cursor="Hand"
                        FontSize="15" ToolTip="设置"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 关闭 -->
                <Button x:Name="CloseButton" Grid.Column="4" Content="✕"
                        Width="40" Height="32" Background="Transparent"
                        Foreground="#FF222222" BorderThickness="0" Cursor="Hand"
                        FontSize="14" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- 任务列表 -->
            <ListBox x:Name="TaskList" Grid.Row="1" Margin="8,4,2,4"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                      IsChecked="{Binding IsDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Checked="Task_CheckedChanged" Unchecked="Task_CheckedChanged"/>
                            <TextBox Grid.Column="1" Margin="6,0,4,0" VerticalAlignment="Center"
                                     BorderThickness="0" Background="Transparent"
                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     PreviewKeyDown="TaskText_PreviewKeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Foreground"
                                                Value="{Binding ElementName=Root, Path=List.TextColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                <Setter Property="Foreground"
                                                        Value="{Binding ElementName=Root, Path=List.TextColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="2" Content="🗑" Width="26" Height="26"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    FontSize="12" ToolTip="删除任务"
                                    Foreground="{Binding ElementName=Root, Path=List.TextColor}"
                                    Click="DeleteTask_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 底部添加任务 -->
            <Button x:Name="AddTaskButton" Grid.Row="2" Content="＋ 添加任务"
                    Margin="8,4,8,8" Padding="8,6" HorizontalAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    FontSize="13" Click="AddTask_Click"/>
        </Grid>
    </Border>
</Window>
